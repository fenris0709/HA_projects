	(text "SENSOR-SCHALTER: GPIO3 (SEN_EN) HIGH -> Q2 leitet -> Q1 (P-MOSFET) schaltet Batterie auf MT3608 -> 5V_SENS fuer beide JSN. LOW/Sleep -> Boost und Sensoren stromlos (R8 haelt Q2 aus)."
		(exclude_from_sim no)
		(at 20 45 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d34ced2b-812e-4bda-807a-e9b477f06a67")
	)
	(text "ESP32-C3 SuperMini dauerhaft aus der Batterie (5V-Pin, 3.3 V onboard). Batteriemessung 1M/1M (nur ca. 2 uA) -> GPIO1. Vor dem Abschalten TRIG1/TRIG2 (GPIO5/GPIO10) auf LOW setzen."
		(exclude_from_sim no)
		(at 20 52 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "e80d40ea-7f54-4854-b50f-1617be36a408")
	)
	(text "GPIO: SEN_EN=GPIO3, VBDIV=GPIO1 (ADC), TRIG1=GPIO5, ECHO1=GPIO6, TRIG2=GPIO10, ECHO2=GPIO20. ECHO 5V -> Teiler 10k/20k -> 3.3 V."
		(exclude_from_sim no)
		(at 165 125 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "e321698f-efa4-42db-af00-f8cc30aee28a")
	)
